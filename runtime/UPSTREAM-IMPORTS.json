  "upstreamCommit": "08106b0c3771ef5b4a5aa176acccd460e88b7325",
  "mode": "selective port with Xynapse adaptations; original upstream base unknown",
  "selectedChanges": [
    "reasoning_content/thinking history (c164661)",
    "Ollama reasoning fields (7503c1c)",
    "config validation (05f0201), including structured hook parser/matcher prerequisites from pinned HEAD",
    "complete Linux launcher probe (525035b), including map-auto fallback"
  ],
  "adaptations": [
    "Preserve Yandex gpt://folder/model/revision and detect DeepSeek V4 within it.",
    "Preserve complete reasoning in CLI and subagent histories; omit raw reasoning from terminal output, exports and summaries.",
    "Count reasoning/signatures in compaction token estimate.",
    "Fail on malformed supported hooks instead of silently dropping them.",
    "Preserve BVC 0.1.1 and existing resolved-credential/error-redaction behavior."
  ],
  "excluded": [
    "claw-analog",
    "claw-rag-service",
    "automatic thinking enablement",
    "full upstream replacement"
  ],
  "limitations": [
    "Windows x64 qualification only; Linux namespace execution not exercised.",
    "rulesImport accepted for schema compatibility only; cross-editor rule-file loading is not implemented by this port."
  ],
