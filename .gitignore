# ===========================================
# Xynapse IDE — .gitignore
# ===========================================

# ===========================================
# Node.js
# ===========================================
node_modules/
.npm
.yarn/
.pnp.*

# ===========================================
# Build outputs (regenerated by npm run build)
# ===========================================
/out/
/dist/
/build/
*.vsix
*.js.map
*.tsbuildinfo
*.zip
VSCode-win32-x64/
portable-build/
.tmp-xynapse*/
.openclaw/
/data/

# ===========================================
# Local source imports that are not part of this repository
# ===========================================
/continue-main/
/extensions/
/диплом/
/.upstream-continue/
/.upstream-vscode/
# Local agent ignore files are excluded by the repository's secret guard.
/plugins/continue-main/.xynapseignore
/plugins/continue-main/extensions/vscode/.xynapseignore

# ===========================================
# Personal scripts and notes (not part of IDE)
# ===========================================
/cu-*
/done*.txt
/clean-compile.bat
/compile-vscode.bat
/control-ultra.cmd
/original_xynapse.bat
/patch-gui-error.js
/MODEL-SYSTEM.md
/TEST-REPORT*.md
/0
/AGENTS.md
/HEARTBEAT.md
/IDENTITY.md
/SOUL.md
/TOOLS.md
/USER.md
/MEMORY.md
/memory/

# ===========================================
# AI code agents — BLOCK ALL config/metadata
# ===========================================
# Xynapse / Anthropic
.xynapse/
.xynapse
.xynapse*
**/XYNAPSE.md
**/xynapse.md
**/Xynapse.md
**/.xynapseignore
**/.xynapserc
**/.xynapserc.*
!plugins/continue-main/.xynapseignore
!plugins/continue-main/extensions/vscode/.xynapseignore
**/xynapse.json
**/xynapse.yaml
**/xynapse.yml
**/.anthropic/
**/.anthropic
**/anthropic.json
**/anthropic.yaml
**/anthropic.yml

# Cursor
.cursor/
.cursor

# Copilot
.copilot/
.github/copilot/

# Other AI agents
.agent/
.ai/
.aider*
.tabby/
.codeium/
.continue/
.continuerc*
.augment/
.windsurf/
.devin/
.sourcegraph/
.cody/
.tabnine/

# Runtime config (user-specific, may contain keys)
.xynapse/

# ===========================================
# Security — API keys, credentials, secrets
# ===========================================
.env
.env.*
*.env
!**/.env.example
secrets.json
secrets.yaml
secrets.yml
credentials.json
credentials.yaml
credentials.yml
*.pem
*.key
*.secret
*.p12
*.pfx
*.crt
*.cer
api_keys.*
api-keys.*
apikeys.*
token.json
tokens.json
auth.json
oauth.json
*.keystore
*.jks
private_key*
service_account*.json
google-credentials.json
firebase-credentials.json
aws-credentials
.aws/
.ssh/
id_rsa*
id_ed25519*
*.pub

# ===========================================
# Config files with potential secrets
# ===========================================
configi/
*.local.json
*.local.yaml
*.local.yml

# ===========================================
# Logs
# ===========================================
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ===========================================
# IDE directories
# ===========================================
.idea/
.fleet/

# ===========================================
# OS files
# ===========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
\#*\#
.#*

# ===========================================
# Test and coverage
# ===========================================
coverage/
.nyc_output/
*.lcov

# ===========================================
# Temporary files
# ===========================================
tmp/
temp/
*.tmp
*.temp
*.bak
*.backup
nul
